<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="004-create-school-section" author="scholora">
        <createTable tableName="school_section">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_school_section" nullable="false"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="school_section"
                                 baseColumnNames="class_id"
                                 constraintName="fk_school_section_class"
                                 referencedTableName="school_class"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="school_section"
                             columnNames="class_id, name"
                             constraintName="uq_school_section_class_name"/>
    </changeSet>
</databaseChangeLog>
