<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="002-create-school-profile" author="scholora">
        <createTable tableName="school_profile">
            <column name="id" type="SMALLINT">
                <constraints primaryKey="true" primaryKeyName="pk_school_profile" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
            <column name="timezone" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE school_profile ADD CONSTRAINT ck_school_profile_singleton CHECK (id = 1);</sql>
        <insert tableName="school_profile">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="My School"/>
            <column name="timezone" value="UTC"/>
        </insert>
    </changeSet>
</databaseChangeLog>
