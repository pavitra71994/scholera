<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="009-create-school-exam" author="scholora">
        <createTable tableName="school_exam">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_school_exam" nullable="false"/>
            </column>
            <column name="section_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="exam_definition_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="school_exam"
                                 baseColumnNames="section_id"
                                 constraintName="fk_school_exam_section"
                                 referencedTableName="school_section"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="school_exam"
                                 baseColumnNames="exam_definition_id"
                                 constraintName="fk_school_exam_definition"
                                 referencedTableName="school_exam_definition"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="school_exam"
                             columnNames="section_id, name, academic_year"
                             constraintName="uq_school_exam_section_name_year"/>
    </changeSet>
</databaseChangeLog>
