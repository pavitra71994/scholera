<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="008-create-school-exam-definition" author="scholora">
        <createTable tableName="school_exam_definition">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_school_exam_definition" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="school_exam_definition"
                             columnNames="name, academic_year"
                             constraintName="uq_school_exam_definition_name_year"/>
    </changeSet>
</databaseChangeLog>
