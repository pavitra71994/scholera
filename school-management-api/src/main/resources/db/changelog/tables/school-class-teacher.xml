<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="013-add-school-class-teacher" author="scholora">
        <addColumn tableName="school_class">
            <column name="class_teacher_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="school_class"
                                 baseColumnNames="class_teacher_id"
                                 constraintName="fk_school_class_class_teacher"
                                 referencedTableName="school_person"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
